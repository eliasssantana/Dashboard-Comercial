table _Medidas
	lineageTag: 9298349c-71a6-4237-ae15-170117b7b1c8

	measure 'Main Card' = ```
			
			
			    VAR vProduto = SELECTEDVALUE(Produto[Produto])
			    VAR vCor1 = SELECTEDVALUE(Produto[Cor 1])
			
			    RETURN
			        fxMainCard(vProduto, vCor1)
			```
		displayFolder: HTML
		lineageTag: 7ff3b5cd-50fb-4c12-b10e-e2decb051c6a

	measure 'Qtd. Vendida' = SUM(Vendas[Quantidade Vendida])
		formatString: 0
		displayFolder: KPIs
		lineageTag: d355bedf-afc1-4732-bc3c-f33afc930a1d

	measure 'Valor Vendido' = SUM(Vendas[Valor Vendido])
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: KPIs
		lineageTag: 05fa03d4-3e20-413f-a3c7-b70b126714ef

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Custo Venda' = SUM(Vendas[Custo da Venda])
		formatString: 0
		displayFolder: KPIs
		lineageTag: a3442aca-9a9b-42a9-bedf-6794703150d6

	measure 'Meta Venda' = SUM(Vendas[Meta de Venda])
		formatString: "R$"\ #,0.0;-"R$"\ #,0.0;"R$"\ #,0.0
		displayFolder: KPIs
		lineageTag: b4c1ff85-ce3b-4a29-967f-b21d66a4a7c3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Main Color' =
			
			
			VAR vCorSelecionada = SELECTEDVALUE(Produto[Cor 1])
			
			VAR vCorHex = "#" & vCorSelecionada
			
			RETURN
			    vCorHex
		displayFolder: Colors
		lineageTag: 22f4e604-6e45-4672-b93a-42267b020918

	measure 'Dica Ferramenta' = ```
			
			
			    VAR vProduto = SELECTEDVALUE(Produto[Produto])
			
			    RETURN
			        fxToolTip(
			            vProduto
			        )
			```
		displayFolder: HTML
		lineageTag: cbbe0c4b-2d24-4179-81db-b32247f71f11

	measure '% Meta' = DIVIDE([Valor Vendido], [Meta Venda])
		displayFolder: KPIs
		lineageTag: a96af340-5be7-450e-8f97-cbb1a55b7c89

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

